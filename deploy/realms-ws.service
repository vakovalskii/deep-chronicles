[Unit]
Description=Realms (Хроники Глубин) WS server
After=network.target
[Service]
WorkingDirectory=/opt/realms/server
ExecStart=/usr/bin/node --no-warnings /opt/realms/server/server.js
Environment=PORT=8790
Environment=DB=/opt/realms/data/realms.db
Restart=always
RestartSec=3
User=root
[Install]
WantedBy=multi-user.target
