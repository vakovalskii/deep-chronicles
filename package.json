{
  "name": "l2-web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --no-warnings server/server.js & vite --host",
    "build": "vite build",
    "test:unit": "node --test tests/unit.test.js",
    "test:e2e": "node tests/e2e.mjs",
    "test": "npm run test:unit && npm run test:server && npm run build && npm run test:e2e",
    "server": "node --no-warnings server/server.js",
    "test:server": "node --no-warnings --test tests/server.test.js"
  },
  "dependencies": {
    "three": "^0.170.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "playwright": "^1.63.0",
    "sharp": "^0.35.4",
    "vite": "^6.0.0"
  }
}
